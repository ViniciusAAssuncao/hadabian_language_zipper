{
    "id": "esperantido_conhab",
    "name": "Esperantido (Réplica Estrutural do Esperanto)",
    "description": "Uma conlang aglutinante e extremamente regular, baseada na gramática do Esperanto. Utiliza o motor de Sandhi e TAM do ConHab para forçar as terminações de classes gramaticais (-o, -a, -e, -i) e aplica as marcações corretas de plural (-j) e acusativo (-n).",
    "word_order": "SVO",
    "subordinate_word_order": "SVO",
    "source_language_order": "SVO",
    "drop_articles": false,
    "pro_drop": {
        "enabled": false
    },
    "alignment": "nominative-accusative",
    "global_seed": 1887,
    "aesthetic_profile": {

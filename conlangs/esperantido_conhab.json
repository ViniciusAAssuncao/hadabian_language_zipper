            "1": 0.1,
            "2": 0.5,
            "3": 0.3,
            "4": 0.1
        },
        "cluster_density": 0.3,
        "vowel_consonant_ratio": 0.5
    },
    "phonotactics": {
        "vowels": "aeiou",
        "consonants": "bcĉdfgĝhĥjĵklmnprsŝtvz",

        "sandhi": {
            "enabled": true,
            "rules": [
                {
                    "pattern": "([aeiou])as\\b",
                    "replacement": "as",
                    "description": "Evita acúmulo de vogais no presente"
                },
                {
                    "pattern": "([aeiou])is\\b",
                    "replacement": "is",
                    "description": "Evita acúmulo de vogais no passado"
                },
                {
                    "pattern": "([aeiou])os\\b",
                    "replacement": "os",
                    "description": "Evita acúmulo de vogais no futuro"
                },
                {
                    "pattern": "([aeiou])us\\b",
                    "replacement": "us",
                    "description": "Evita acúmulo de vogais no condicional"
                },
                {
                    "pattern": "([aeiou])u\\b",
                    "replacement": "u",
                    "description": "Evita acúmulo de vogais no imperativo"
                },
                {
                    "pattern": "([aeiou])i\\b",
                    "replacement": "i",
                    "description": "Evita acúmulo de vogais no infinitivo"
                },
                {
                    "pattern": "([bcĉdfgĝhĥjĵklmnprsŝtvz])j\\b",
                    "replacement": "\\1oj",
                    "description": "Força a desinência nominal -o antes do plural se a raiz terminar em consoante"
                },
                {
                    "pattern": "([bcĉdfgĝhĥjĵklmnprsŝtvz])n\\b",
                    "replacement": "\\1on",
                    "description": "Força a desinência nominal -o antes do acusativo se a raiz terminar em consoante"
                },
                {
                    "pattern": "([bcĉdfgĝhĥjĵklmnprsŝtvz])jn\\b",
                    "replacement": "\\1ojn",
                    "description": "Força a desinência nominal -o antes do plural acusativo"
                }
            ]
        }
    },

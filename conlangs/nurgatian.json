    "design_notes": {
        "inspiration": "Línguas tonais do Sudeste Asiático, Polinésio, com substrato Semítico",
        "character": "Musical, vocálico, fluido, ligado, rítmico, melódico",
        "key_features": [
            "Sistema de cinco tons com funções gramaticais",
            "Quatro níveis de quantidade vocálica (único no mundo)",
            "Inventário consonantal mínimo (apenas 9 consoantes)",
            "Ritmo silábico isocrônico estrito",
            "Sistema de ligação obrigatória entre palavras",
            "Estrutura tópico-comentário obrigatória",
            "Sem artigos definidos ou indefinidos",
            "Sistema de casos robusto (8 casos)",
            "Verbos seriais altamente produtivos",
            "Sistema de classificadores numeral obrigatório",
            "Harmonia vocálica de posterioridade e altura",
            "Pro-drop quando tópico estabelecido",
            "Evidencialidade marcada por tom e partículas"
        ],
        "aesthetic_goals": [
            "Som EXTREMAMENTE VOCÁLICO e MUSICAL",
            "Fluxo contínuo sem quebras consonantais",
            "Clareza e distinção de cada sílaba",
            "Musicalidade através de tons e comprimento",
            "Elegância e suavidade sonora",
            "Complexidade através de simplicidade"
        ],
        "historical_context": {
            "peak_period": "220.000-190.000 AH",
            "decline": "190.000-180.000 AH",
            "extinction": "c. 180.000 AH",
            "last_speakers": "Comunidades isoladas do interior de Nur-Gate",
            "legacy": "Influenciou substrato tonal em línguas arinianas, empréstimos em Akoshiano",
            "cultural_significance": "Língua da poesia épica e hinos agrícolas do Vale Fértil"
        },
        "sample_texts": {

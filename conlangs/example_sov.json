{
  "id": "example_sov",
  "name": "Exemplo SOV com Casos e Harmonia",
  "description": "Língua exemplo com ordem SVO na principal e SOV na subordinada (estilo Alemão), sistema de casos e harmonização vocálica.",
  "word_order": "SVO",
  "subordinate_word_order": "SOV",
  "source_language_order": "SVO",
  "drop_articles": true,
  "pro_drop": true,
  "alignment": "ergative-absolutive",
  "global_seed": 42857,
  "phonotactics": {
    "vowels": "aeiou",
    "consonants": "bdfghjklmnprstvz",
    "syllable_templates": ["CV", "CVC", "V", "VC"],
    "min_syllables": 1,
    "max_syllables": 3,
    "max_consonant_cluster": 2,
    "max_vowel_cluster": 1,
    "forbidden_initial_clusters": ["zr", "nm"],
    "forbidden_final_consonants": ["h"],
    "epenthesis_vowel": "i",
    "diphthongs": ["ai", "ei", "ou", "au"]
  },
  "semantic_fields": {
    "enabled": true,
    "auto_detect": true,
    "use_nltk": true,
    "threshold": 0.3,
    "manual_groups": {
      "rio": "água",
      "chuva": "água",
      "sede": "água",
      "lago": "água",
      "mar": "água",
      "fogo": "calor",
      "sol": "calor"
    }
  },
  "polysemy_rules": {
    "enabled": true,
    "merges": {
      "azul": "céu",
      "oceano": "mar",
      "chama": "fogo"
    },
    "splits": {
      "ser": [
        {
          "target_suffix": "_permanente",
          "rules": {
            "feats": ["Mood=Ind", "Tense=Pres"]
          }
        },
        {
          "target_suffix": "_transitorio",
          "rules": {
            "feats": ["Mood=Sub"]
          }
        }
      ],
      "banco": [
        {
          "target_suffix": "_inst",
          "rules": {
            "deprel": ["nmod", "obj"]
          }
        },
        {
          "target_suffix": "_assento",
          "rules": {
            "deprel": ["obl"]
          }
        }
      ]
    }
  },
  "false_cognates": {
    "enabled": true,
    "natural_confusion_chance": 0.2,
    "manual_pairs": {
      "noite": "dia",
      "esquerda": "direita",
      "homem": "mulher"
    }
  },
  "vowel_harmony": {
    "enabled": true,
    "groups": {
      "front": "ei",
      "back": "aou"
    },
    "rules": [
      {
        "input": "a",
        "map": {
          "front": "e",
          "back": "a"
        }
      },
      {
        "input": "o",
        "map": {
          "front": "e",
          "back": "o"
        }
      }
    ]
  },
  "case_system": {
    "enabled": true,
    "preposition_handling": "replace",
    "markers": {
      "ergative": {
        "marker": "ka",
        "type": "suffix"
      },
      "absolutive": {
        "marker": "",
        "type": "suffix"
      },
      "nominative": {
        "marker": "wa",
        "type": "particle_after"
      },
      "accusative": {
        "marker": "ma",
        "type": "suffix"
      },
      "dative": {
        "marker": "ni",
        "type": "particle_before"
      },
      "genitive": "-sa",
      "locative": "-la"
    },
    "marker_position": "suffix"
  },
  "tam_system": {
    "enabled": true,
    "infer_imperative_from_context": true,
    "rules": [
      {
        "features": ["Tense=Past"],
        "marker": "da",
        "type": "suffix"
      },
      {
        "features": ["Tense=Imp"],
        "marker": "va",
        "type": "suffix"
      },
      {
        "features": ["Mood=Imp"],
        "marker": "va",
        "type": "suffix"
      },
      {
        "features": ["Tense=Fut"],
        "marker": "go",
        "type": "particle_before"
      },
      {
        "features": ["Mood=Cnd"],
        "marker": "ria",
        "type": "suffix"
      },
      {
        "features": ["Mood=Sub"],
        "marker": "ke",
        "type": "particle_before"
      }
    ]
  },
  "agreement_rules": {
    "gender_agreement": false,
    "number_agreement": true
  },
  "topicalization": {
    "enabled": true,
    "position": "initial",
    "topic_marker": "wa",
    "reintroduce_articles": true
  },
  "focus_structure": {
    "enabled": true,
    "object_focus_marker": "ko",
    "verb_focus_marker": "do",
    "suppress_case": true
  },
  "functional_particles": {
    "muito": {
      "noun_position": "post_nominal",
      "adj_position": "pre_nominal",
      "verb_position": "post_verbal"
    }
  },
  "degree_system": {
    "enabled": true,
    "source_rules": [
      {
        "type": "diminutive",
        "suffix": "zinho",
        "replacement": ""
      },
      {
        "type": "diminutive",
        "suffix": "zinha",
        "replacement": ""
      },
      {
        "type": "diminutive",
        "suffix": "inho",
        "replacement": "o"
      },
      {
        "type": "diminutive",
        "suffix": "inha",
        "replacement": "a"
      },
      {
        "type": "augmentative",
        "suffix": "zão",
        "replacement": ""
      },
      {
        "type": "augmentative",
        "suffix": "zona",
        "replacement": ""
      },
      {
        "type": "augmentative",
        "suffix": "ão",
        "replacement": "o"
      },
      {
        "type": "superlative",
        "suffix": "íssimo",
        "replacement": "o"
      },
      {
        "type": "superlative",
        "suffix": "íssima",
        "replacement": "a"
      }
    ],
    "rules": {
      "diminutive": {
        "affix": "ina",
        "position": "suffix"
      },
      "augmentative": {
        "affix": "ona",
        "position": "suffix"
      },
      "superlative": {
        "affix": "isa",
        "position": "suffix"
      }
    }
  },
  "affix_system": {
    "enabled": true,
    "source_suffixes": [
      {
        "input_pos": "NOUN",
        "suffix": "dor",
        "replacement": "r",
        "target_pos": "VERB"
      },
      {
        "input_pos": "NOUN",
        "suffix": "ção",
        "replacement": "r",
        "target_pos": "VERB"
      },
      {
        "input_pos": "ADV",
        "suffix": "mente",
        "replacement": "x",
        "target_pos": "ADJ"
      }
    ],
    "derivation_rules": [
      {
        "from_pos": "VERB",
        "to_pos": "NOUN",
        "type": "agent",
        "affix": "tu",
        "position": "suffix"
      },
      {
        "from_pos": "ADJ",
        "to_pos": "ADV",
        "affix": "li",
        "position": "suffix"
      },
      {
        "from_pos": "NOUN",
        "to_pos": "ADJ",
        "affix": "ka",
        "position": "suffix"
      }
    ]
  },
  "reduplication": {
    "enabled": true,
    "rules": [
      {
        "features": ["Number=Plur"],
        "method": "first_syllable",
        "separator": ""
      },
      {
        "features": ["Degree=Abs"],
        "method": "whole_word",
        "separator": "-"
      }
    ]
  },
  "style": {
    "capitalization": true
  }
}

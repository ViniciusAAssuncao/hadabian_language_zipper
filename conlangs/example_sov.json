  "consonant_mutation": {
    "enabled": true,
    "rules": [
      {
        "name": "Lenition",
        "description": "Suaviza consoantes após o marcador de tópico 'wa' ou determinantes",
        "triggers": {
          "words": [
            "wa"
          ],
          "pos": [
            "DET"
          ]
        },
        "mutations": {
          "p": "b",
          "t": "d",
          "k": "g",
          "f": "v",
          "m": "v",
          "s": "z"
        }
      },
      {
        "name": "Nasalization",
        "description": "Nasaliza oclusivas sonoras após palavras terminadas em n ou m",
        "triggers": {
          "ending_chars": [
            "n",
            "m"
          ]
        },
        "mutations": {
          "b": "m",
          "d": "n",
          "g": "ng"
        }
      }
    ]
  },

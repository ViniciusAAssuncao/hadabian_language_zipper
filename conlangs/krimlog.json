    "design_principles": {
        "description": "Princípios de design do Krimlog como língua auxiliar planejada",
        "principles": [
            "Regularidade absoluta - sem exceções gramaticais",
            "Morfologia isolante - sem flexões complexas",
            "Ordem SVO estrita - sem inversões",
            "Vocabulário internacional - baseado no RMP com simplificação",
            "Fonologia simples - apenas sons comuns (com adição de û para nomes culturais)",
            "Sem gênero gramatical - neutralidade",
            "Sem concordância - economia cognitiva",
            "Partículas TAM - clareza temporal",
            "Derivação transparente - afixos regulares (-om, -iik, -at)",
            "Facilidade de aprendizagem - estrutura previsível"
        ],
        "target_learning_time": "100-200 horas para fluência básica",
        "target_vocabulary": "2000-3000 palavras base",
        "creation_date": "1799 AH",
        "creation_context": "Congresso Mundial de Linguística - Liga de Hadab",
        "official_status": "Língua franca auxiliar de Hadab",
        "native_speakers": 0,
        "second_language_speakers": "estimado 40-60 milhões (ano 2000 AH)"

            "cross_word_boundary": true,
            "rules": [
                {
                    "pattern": "a\\s+a",
                    "replacement": "ā",
                    "description": "Fusão de vogais idênticas curtas (a + a = ā)"
                },
                {
                    "pattern": "ā\\s+a",
                    "replacement": "ā",
                    "description": "Fusão de longa e curta (ā + a = ā)"
                },
                {
                    "pattern": "a\\s+ā",
                    "replacement": "ā",
                    "description": "Fusão de curta e longa (a + ā = ā)"
                },
                {
                    "pattern": "i\\s+i",
                    "replacement": "ī",
                    "description": "Fusão de vogais (i + i = ī)"
                },
                {
                    "pattern": "u\\s+u",
                    "replacement": "ū",
                    "description": "Fusão de vogais (u + u = ū)"
                },
                {
                    "pattern": "a\\s+i",
                    "replacement": "e",
                    "description": "Guna Sandhi (a + i = e)"
                },
                {
                    "pattern": "a\\s+u",
                    "replacement": "o",
                    "description": "Guna Sandhi (a + u = o)"
                },
                {
                    "pattern": "i\\s+([aāuūeo])",
                    "replacement": "y\\1",
                    "description": "Yan Sandhi (i + V = yV)"
                },
                {
                    "pattern": "u\\s+([aāiīeo])",
                    "replacement": "v\\1",
                    "description": "Yan Sandhi (u + V = vV)"
                },
                {
                    "pattern": "as\\s+([bdgjlrvymnñ])",
                    "replacement": "o \\1",
                    "description": "Visarga Sandhi (as + vozeada = o)"
                },
                {
                    "pattern": "s\\s+([bdgjlrvymnñ])",
                    "replacement": "r \\1",
                    "description": "Visarga Sandhi genérico (s + vozeada = r)"
                },
                {
                    "pattern": "m\\s+([pbtdkgcjśṣs])",
                    "replacement": "ṃ \\1",
                    "description": "Anusvara Sandhi (m no final torna-se nasal pura ṃ antes de consoante)"
                },
                {
                    "pattern": "t\\s+c",
                    "replacement": "c c",
                    "description": "Assimilação de T antes de C"
                },
                {
                    "pattern": "t\\s+j",
                    "replacement": "j j",
                    "description": "Assimilação de T antes de J"
                }
            ]
        }

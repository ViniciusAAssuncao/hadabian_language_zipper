      "nurgatization_phenomenon": {
        "name": "nurgatização",
        "description": "Fenômeno linguístico central caracterizado pela suavização vocálica e perda de elementos guturais/desérticos típicos do raabico ancestral",
        "phonological_changes": {
          "glottal_stop_loss": {
            "change": "ʔ → Ø / V_V",
            "description": "Perda completa do glotal stop intervocálico",
            "compensation": "alongamento vocálico ou formação de ditongo",
            "examples": [
              "qaʔala → qaala → kale (falar)",
              "maʔakul → maakul → makul (comida)"
            ]
          },
          "glottal_stop_loss_initial": {
            "change": "ʔ → Ø / #_",
            "description": "Perda de glotal inicial",
            "compensation": "nenhuma ou prótese vocálica",
            "examples": [
              "ʔakala → akala → akal (comer)",
              "ʔanta → anta → ante (tu)"
            ]
          },
          "vowel_length_neutralization": {
            "change": "V̄ → V",
            "description": "Perda da distinção de quantidade vocálica (mácron)",
            "affected": [
              "ā",
              "ī",
              "ū",
              "ē",
              "ō"
            ],
            "result": [
              "a",
              "i",
              "u",
              "e",
              "o"
            ],
            "exceptions": "Alguns mácron preservados em posição tônica ou compensatória",
            "examples": [
              "kitāb → kitab (livro)",
              "ṣalāt → salat (oração)",
              "qadīm → kadim (antigo)"
            ]
          },
          "umlaut_development": {
            "change": "V → V̈ / _Ci",
            "description": "Desenvolvimento de trema/umlaut por assimilação regressiva",
            "trigger": "vogais altas em sílabas seguintes",
            "results": {
              "a → ä": "em contextos palatais",
              "o → ö": "antes de /i/ ou /j/",
              "u → ü": "em harmonia frontal"
            },
            "examples": [
              "ħabib → habib → häbib (amigo)",
              "šukr → šukr → šükr (agradecimento)"
            ]
          },
